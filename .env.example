DATABASE_URL=postgres://jmail:jmail@localhost:5433/jmail
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# 32-byte hex key used to encrypt refresh tokens at rest. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# TypeSafe (Jev) API key for inbox triage at sync time. Optional: without it, sync still works and no labels are produced.
TYPESAFE_API_KEY=
# --- Inbox chat (RAG) ---
# Embeddings: "ollama" (default, local + free) or "voyage" (hosted). Changing provider/model needs a re-index: POST /api/index?reset=1
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# VOYAGE_API_KEY=
# VOYAGE_EMBEDDING_MODEL=voyage-4-large
# Reranker: "local" (default, mixedbread mxbai-rerank-base-v1 on-device, free), "voyage" (rerank-2.5, needs VOYAGE_API_KEY), or "none".
RERANKER=local
# LOCAL_RERANK_MODEL=mixedbread-ai/mxbai-rerank-base-v1
# VOYAGE_RERANK_MODEL=rerank-2.5
# Answer generation (Claude). Required for the chat panel.
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5
